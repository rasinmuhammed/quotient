# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
QUOTIENT_MODEL=openai/gpt-oss-120b
QUOTIENT_REASONING_EFFORT=medium

# Optional tracing. Leave empty for a no-op tracer.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Frontend origin allowed by the API (comma separated).
QUOTIENT_CORS_ORIGINS=http://localhost:3000
