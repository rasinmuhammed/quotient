# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
# qwen3.8-27b in instruct mode (effort none) is what the evals ran; gpt-oss models take low, medium or high.
QUOTIENT_MODEL=qwen/qwen3.8-27b
QUOTIENT_REASONING_EFFORT=none

# Optional tracing. Leave empty for a no-op tracer.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Frontend origin allowed by the API (comma separated).
QUOTIENT_CORS_ORIGINS=http://localhost:3000
